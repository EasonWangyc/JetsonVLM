 class TensorRegistry
 {
 public:
+    //! Host-side state for one TensorRT execution context. The cache is optional;
+    //! a null pointer preserves the original bind-every-call behavior.
+    struct BindingState
+    {
+        uintptr_t address{0};
+        nvinfer1::Dims shape{};
+        bool addressValid{false};
+        bool shapeValid{false};
+    };
+
+    using BindingCache = std::unordered_map<std::string, BindingState>;
+
+    static bool dimsEqual(nvinfer1::Dims const& lhs, nvinfer1::Dims const& rhs) noexcept;
@@ -86,1 +97,2 @@
     bool bindAll(
-        nvinfer1::IExecutionContext* ctx, TensorMap const& tensorMap, InferenceDims const& inferenceDims) const;
