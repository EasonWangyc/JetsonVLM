+        BindingCache* cache = nullptr) const;
diff --git a/cpp/runtime/exec/tensorRegistry.cpp b/cpp/runtime/exec/tensorRegistry.cpp
--- a/cpp/runtime/exec/tensorRegistry.cpp
+++ b/cpp/runtime/exec/tensorRegistry.cpp
@@ -133,0 +134,13 @@
+bool TensorRegistry::dimsEqual(nvinfer1::Dims const& lhs, nvinfer1::Dims const& rhs) noexcept
+{
+    if (lhs.nbDims != rhs.nbDims)
+    {
+        return false;
+    }
+    for (int32_t i = 0; i < lhs.nbDims; ++i)
+    {
+        if (lhs.d[i] != rhs.d[i])
+        {
+            return false;
+        }
+    }
+    return true;
+}
 
