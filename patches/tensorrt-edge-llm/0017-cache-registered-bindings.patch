+        if (cachedState == nullptr || !cachedState->addressValid || cachedState->address != address)
         {
-            LOG_ERROR("setTensorAddress failed for '%s'", spec.name.c_str());
-            success = false;
-            continue;
+            if (!ctx->setTensorAddress(spec.name.c_str(), tensor->rawPointer()))
+            {
+                LOG_ERROR("setTensorAddress failed for '%s'", spec.name.c_str());
+                success = false;
+                continue;
+            }
+            if (cachedState != nullptr)
+            {
