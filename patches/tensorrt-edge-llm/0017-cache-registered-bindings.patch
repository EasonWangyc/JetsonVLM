+    BindingCache* cache) const
@@ -147,1 +148,18 @@
-        if (!ctx->setTensorAddress(spec.name.c_str(), tensor->rawPointer()))
+        BindingState* cachedState = cache != nullptr ? &(*cache)[spec.name] : nullptr;
