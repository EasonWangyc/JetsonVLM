diff --git a/cpp/runtime/exec/engineExecutor.h b/cpp/runtime/exec/engineExecutor.h
--- a/cpp/runtime/exec/engineExecutor.h
+++ b/cpp/runtime/exec/engineExecutor.h
@@ -182,2 +182,4 @@
     nvinfer1::IExecutionContext* mContext{nullptr};
     TensorRegistry mRegistry;
+    bool mAllEngineIORegistered{false};
+    bool mSkipFallbackBindingScan{false};
diff --git a/cpp/runtime/exec/engineExecutor.cpp b/cpp/runtime/exec/engineExecutor.cpp
--- a/cpp/runtime/exec/engineExecutor.cpp
+++ b/cpp/runtime/exec/engineExecutor.cpp
@@ -132,4 +132,22 @@
     registerOptionalTreeMetadata(binding_names::kTreeParentIds);
     registerOptionalTreeMetadata(binding_names::kTreeDepths);
+
+    mAllEngineIORegistered = true;
+    for (int32_t i = 0; i < mEngine->getNbIOTensors(); ++i)
+    {
+        if (!mRegistry.contains(mEngine->getIOTensorName(i)))
+        {
+            mAllEngineIORegistered = false;
+            break;
+        }
+    }
+    char const* skipFallbackBindingScan = std::getenv("EDGELLM_SKIP_FALLBACK_BINDING_SCAN");
+    mSkipFallbackBindingScan
+        = skipFallbackBindingScan != nullptr && std::string_view{skipFallbackBindingScan} == "1";
+    if (mSkipFallbackBindingScan && mAllEngineIORegistered)
+    {
+        LOG_INFO("fallback binding scan skip enabled; all engine I/O tensors are registry-managed");
+    }
+    else if (mSkipFallbackBindingScan)
+    {
+        LOG_WARNING("fallback binding scan skip requested but engine has unregistered I/O; retaining scan");
+    }
@@ -291,6 +291,14 @@
     if (!mRegistry.bindAll(mContext, map, dims, bindingCache))
     {
         LOG_ERROR("bindAll failed for profile %d", profileIndex);
         return false;
     }
+
+    if (mSkipFallbackBindingScan && mAllEngineIORegistered)
+    {
+        if (mCacheBindingState)
+        {
+            refreshPreparedBindingState();
+        }
+        return true;
+    }
