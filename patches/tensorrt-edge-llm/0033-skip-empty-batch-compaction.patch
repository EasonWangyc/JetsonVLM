diff --git a/cpp/runtime/llmInferenceRuntime.cpp b/cpp/runtime/llmInferenceRuntime.cpp
--- a/cpp/runtime/llmInferenceRuntime.cpp
+++ b/cpp/runtime/llmInferenceRuntime.cpp
@@ -1944,8 +1944,12 @@ bool LLMInferenceRuntime::performBatchEvict(DecodingInferenceContext& context, DecodingStrategy& strategy)
         cudaMemcpyHostToDevice, context.stream));
 
     // Compact base model caches (KV + Mamba) via the HybridCacheManager single-call API.
-    mSharedResources->cacheManagers[0]->compactBatch(
-        mDeviceBatchMapping, oldActiveBatch, newActiveBatch, context.stream);
+    // When all slots are evicted there is no survivor to move. Avoid launching
+    // one no-op compaction kernel per cache layer; strategy.onBatchEvict below
+    // still receives the mapping so strategy-specific cleanup remains intact.
+    if (newActiveBatch > 0)
+    {
+        mSharedResources->cacheManagers[0]->compactBatch(
+            mDeviceBatchMapping, oldActiveBatch, newActiveBatch, context.stream);
+    }
     mSharedResources->cacheManagers[0]->setActiveBatchSize(newActiveBatch);
