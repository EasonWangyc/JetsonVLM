+void VanillaDecoder::onBatchEvict(std::vector<int32_t> const&, int32_t oldActiveBatch, int32_t newActiveBatch,
+    Tensor& deviceBatchMapping, cudaStream_t stream)
+{
+    if (newActiveBatch <= 0)
+    {
+        return;
+    }
+
+    auto const indicesShape = mRuntime.sampling.indices.getShape();
+    check::check(indicesShape.getNumDims() == 2 && indicesShape[0] == oldActiveBatch,
+        "Sampling indices shape mismatch during batch eviction");
+    kernel::compactTensorBatch(mRuntime.sampling.indices, deviceBatchMapping, mRuntime.sampling.indices,
+        oldActiveBatch, newActiveBatch, stream);
+    check::check(mRuntime.sampling.indices.reshape({newActiveBatch, 1}), "Tensor reshape failed");
+}
