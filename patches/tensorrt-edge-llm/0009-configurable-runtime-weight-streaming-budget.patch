+std::optional<int64_t> weightStreamingBudgetFromEnvironment()
+{
+    char const* const value = std::getenv("EDGELLM_WEIGHT_STREAMING_BUDGET_BYTES");
+    if (value == nullptr)
+    {
+        return std::nullopt;
+    }
+
+    std::string const text{value};
+    size_t parsedCharacters{0};
+    int64_t budget{-1};
+    try
+    {
+        budget = std::stoll(text, &parsedCharacters);
+    }
+    catch (std::exception const&)
+    {
+        throw std::invalid_argument("EDGELLM_WEIGHT_STREAMING_BUDGET_BYTES must be a non-negative integer");
+    }
+    if (parsedCharacters != text.size() || budget < 0)
+    {
+        throw std::invalid_argument("EDGELLM_WEIGHT_STREAMING_BUDGET_BYTES must be a non-negative integer");
+    }
+    return budget;
+}
 } // namespace
 
