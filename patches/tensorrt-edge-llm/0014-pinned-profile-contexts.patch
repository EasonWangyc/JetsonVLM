+
+bool EngineExecutor::selectProfileContext(int32_t profileIndex, cudaStream_t stream)
+{
+    if (profileIndex < 0 || profileIndex >= mEngine->getNbOptimizationProfiles())
+    {
+        LOG_ERROR("invalid optimization profile index %d", profileIndex);
+        return false;
+    }
+
+    auto contextIt = mProfileContexts.find(profileIndex);
+    if (contextIt == mProfileContexts.end())
+    {
+        auto context = std::unique_ptr<nvinfer1::IExecutionContext>(
+            mEngine->createExecutionContext(nvinfer1::ExecutionContextAllocationStrategy::kUSER_MANAGED));
+        if (context == nullptr)
+        {
+            LOG_ERROR("failed to create execution context for profile %d", profileIndex);
+            return false;
+        }
+        setNonBlockingAuxStreams(context.get(), mEngine.get(), mAuxStreams);
+        if (mContextMemory != nullptr)
+        {
+            context->setDeviceMemoryV2(mContextMemory, mContextMemorySize);
+        }
+        if (mProfiler != nullptr)
+        {
+            context->setProfiler(mProfiler);
+        }
+        bool const profileSwitchTimingEnabled = [] {
+            char const* value = std::getenv("EDGELLM_PROFILE_SWITCH_TIMING");
+            return value != nullptr && std::string_view{value} == "1";
+        }();
+        auto const profileSwitchStart = std::chrono::steady_clock::now();
+        bool const profileSwitchSucceeded = context->setOptimizationProfileAsync(profileIndex, stream);
+        auto const profileSwitchEnd = std::chrono::steady_clock::now();
+        if (profileSwitchTimingEnabled)
+        {
+            double const elapsedMs = std::chrono::duration<double, std::milli>(profileSwitchEnd - profileSwitchStart).count();
+            LOG_INFO("pinned profile initialization call profile=%d elapsed_ms=%.3f success=%s; "
+                     "this is host API-call time, not GPU completion time",
+                profileIndex, elapsedMs, profileSwitchSucceeded ? "true" : "false");
+        }
+        if (!profileSwitchSucceeded)
+        {
+            LOG_ERROR("failed to initialize optimization profile %d", profileIndex);
+            return false;
+        }
+        contextIt = mProfileContexts.emplace(profileIndex, std::move(context)).first;
+        LOG_INFO("created pinned execution context for optimization profile %d", profileIndex);
+    }
+
+    mContext = contextIt->second.get();
+    return true;
+}
