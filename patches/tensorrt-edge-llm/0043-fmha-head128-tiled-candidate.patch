diff --git a/cpp/kernels/contextAttentionKernels/contextFMHARunner.cpp b/cpp/kernels/contextAttentionKernels/contextFMHARunner.cpp
--- a/cpp/kernels/contextAttentionKernels/contextFMHARunner.cpp
+++ b/cpp/kernels/contextAttentionKernels/contextFMHARunner.cpp
@@ -23,5 +23,7 @@
 #include <cuda_fp16.h>
 #include <math.h>
 #include <memory>
+#include <cstdlib>
+#include <cstring>
 #include <mutex>
 #include <unordered_map>
@@ -369,4 +370,15 @@ ContextFMHARunner::ContextFMHARunner(nvinfer1::DataType const dataType, int32_t
             mLaunchParams.use_granular_tiling = true;
         }
     }
+    // The default heuristic keeps head_dim=128 on the non-tiled kernel because
+    // tiled kernels can lose work to tile quantization.  On the target SM87,
+    // long Qwen3-VL prompts also have a compiled tiled head_dim=128 cubin;
+    // expose it as an explicit A/B candidate without changing the default.
+    char const* const force_tiled = std::getenv("EDGELLM_FMHA_FORCE_GRANULAR_TILING");
+    if (force_tiled != nullptr && std::strcmp(force_tiled, "1") == 0 && mSmVersion == fmha_v2::kSM_87
+        && mHeadSize == 128 && mPaddedSequenceLen > 64)
+    {
+        mLaunchParams.use_granular_tiling = true;
+        LOG_INFO("ContextFMHA: forced tiled head_dim=128 candidate for SM87 (S=%d)", mPaddedSequenceLen);
+    }
 }
