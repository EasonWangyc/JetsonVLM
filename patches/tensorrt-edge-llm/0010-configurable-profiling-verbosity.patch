     }
 
+    if (char const* value = std::getenv("EDGELLM_PROFILING_VERBOSITY"))
+    {
+        std::string const verbosity{value};
+        nvinfer1::ProfilingVerbosity profilingVerbosity{};
+        if (verbosity == "none")
+        {
+            profilingVerbosity = nvinfer1::ProfilingVerbosity::kNONE;
+        }
+        else if (verbosity == "layer_names_only")
+        {
+            profilingVerbosity = nvinfer1::ProfilingVerbosity::kLAYER_NAMES_ONLY;
+        }
+        else if (verbosity == "detailed")
+        {
+            profilingVerbosity = nvinfer1::ProfilingVerbosity::kDETAILED;
+        }
+        else
+        {
+            throw std::invalid_argument("EDGELLM_PROFILING_VERBOSITY must be none, layer_names_only, or detailed");
+        }
+        config->setProfilingVerbosity(profilingVerbosity);
+        LOG_INFO("TensorRT profiling verbosity: %s", value);
+    }
